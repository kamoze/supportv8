        image: postgres:17-alpine
        env:
          POSTGRES_PASSWORD: support-workspace-test
        ports:
          - 5432:5432
        options: >-
          --health-cmd \"pg_isready -U postgres\"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    steps:
    - uses: actions/checkout@v4

    - name: Use Node.js 22.x
      uses: actions/setup-node@v4
      with:
        node-version: 22.x
        cache: 'npm'

    - name: Install Dependencies
      run: npm ci || npm install

    - name: Run Vitest Unit Tests
      run: npx vitest run

    - name: Rehearse Runtime Support workspace migration and RLS
      run: npx vitest run test/runtime-support-workspace.postgres.test.ts
      env:
        SUPPORTV8_REAL_POSTGRES: 1
        SUPPORTV8_WORKSPACE_TEST_DATABASE_URL: postgresql://postgres:support-workspace-test@127.0.0.1:5432/postgres

