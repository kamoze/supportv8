{
  "realm": "supportv8",
  "displayName": "ServiceV8 Support (SupportV8)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "support_superadmin",
        "description": "Full platform administration and system overrides"
      },
      {
        "name": "support_cx_lead",
        "description": "CX Director / Lead, triage rules, policy authoring, auto-refunds up to $500"
      },
      {
        "name": "support_operator",
        "description": "Frontline support operator, ticket triage, live chat resolution"
      },
      {
        "name": "support_contractor_lead",
        "description": "Contractor technician lead, job orders, PIN verification"
      },
      {
        "name": "support_technician",
        "description": "Field technician, electronic lockbox site passes"
      },
      {
        "name": "support_observer",
        "description": "Read-only access to metrics and audit logs"
      }
    ]
  },
  "groups": [
    {
      "name": "Platform Administrators",
      "path": "/Platform Administrators",
      "realmRoles": ["support_superadmin", "support_cx_lead"]
    },
    {
      "name": "CX Directors & Leads",
      "path": "/CX Directors & Leads",
      "realmRoles": ["support_cx_lead"]
    },
    {
      "name": "Frontline Support Operators",
      "path": "/Frontline Support Operators",
      "realmRoles": ["support_operator"]
    },
    {
      "name": "Field Contractors & Technicians",
      "path": "/Field Contractors & Technicians",
      "realmRoles": ["support_contractor_lead", "support_technician"]
    },
    {
      "name": "Compliance & Audit Observers",
      "path": "/Compliance & Audit Observers",
      "realmRoles": ["support_observer"]
    }
  ],
  "clients": [
    {
      "clientId": "supportv8-app",
      "name": "SupportV8 Web Application & ROPC Client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://*.support.servicev8.com/*",
        "https://support.servicev8.com/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": ["+"]
    },
    {
      "clientId": "supportv8-admin-sa",
      "name": "SupportV8 Admin Service Account",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "supportv8-service",
      "name": "SupportV8 Interservice Principal",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
