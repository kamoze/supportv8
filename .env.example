# ==============================================================================
# SupportV8 Platform Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# Database & Cache
# Use the NOBYPASSRLS application role. Production connects through PgBouncer
# on 6432; migrations use a separate administrative connection.
DATABASE_URL=postgresql://supportv8_app:replace_me@localhost:6432/postgres
SUPPORTV8_DB_SCHEMA=supportv8
SUPPORTV8_TENANT_SETTING=app.current_tenant_id
SUPPORTV8_REQUIRE_TENANT_CONTEXT=true
SUPPORTV8_DB_POOL_MAX=10
SUPPORTV8_DB_STATEMENT_TIMEOUT=15s
# Redis is transient cache/pub-sub only. Chat transcripts live in PostgreSQL.
REDIS_URL=redis://localhost:6379

# Operator tokens are verified against this Keycloak realm. The supportv8-app
# client must emit the signed tenant_id claim.
KEYCLOAK_ADMIN_BASE_URL=https://keycloak.servicev8.com
SUPPORTV8_OIDC_REALM=supportv8
SUPPORTV8_OIDC_CLIENT_ID=supportv8-app

# Inbound customer channels fail closed. Keep disabled until the matching
# provider verifier and secrets have been configured in the deployment.
SUPPORTV8_WHATSAPP_INGRESS_ENABLED=false
SUPPORTV8_EMAIL_INGRESS_ENABLED=false
WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me

# Resend Email Integration (Leads & Notifications)
# In production, injected via ExternalSecret from AWS SSM (/servicev8/supportv8-secrets or /servicev8/supportv8-resend)
RESEND_API_KEY=re_your_api_key_here
LEADS_INBOX_EMAIL=leads@servicev8.com
RESEND_FROM_EMAIL=SupportV8 <notifications@servicev8.com>

# Interservice URLs
DOMINION_URL=http://localhost:3000
GROWTHV8_URL=http://localhost:3001
KNOWLEDGEV8_URL=http://localhost:3002
FORGE_URL=http://localhost:8080

# S3 Document Vault (MinIO / AWS S3)
AWS_S3_BUCKET=supportv8-kb-documents
AWS_S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
