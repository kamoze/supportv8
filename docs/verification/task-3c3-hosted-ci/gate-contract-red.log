      run: npx vitest run test/runtime-support-handoff.postgres.test.ts
      env:
        SUPPORTV8_REAL_POSTGRES: 1
        SUPPORTV8_WORKSPACE_TEST_DATABASE_URL: postgresql://postgres:support-workspace-test@127.0.0.1:5432/postgres

    - name: Verify Runtime Support durable ticket writes and RLS
      run: npx vitest run test/runtime-ticket-write.postgres.test.ts
      env:
        SUPPORTV8_REAL_POSTGRES: 1
        SUPPORTV8_WORKSPACE_TEST_DATABASE_URL: postgresql://postgres:support-workspace-test@127.0.0.1:5432/postgres

    - name: Next.js Production Build
      run: npm run build
      env:
        NEXT_TELEMETRY_DISABLED: 1
        NODE_ENV: production

    - name: Verify standalone Runtime Support host and logout boundary
      run: npx vitest run test/runtime-support-next-standalone.test.ts
